{
  "expo": {
    "name": "Alarm Klock",
    "slug": "alarm-klock",
    "version": "1.0.1",
    "description": "Alarm Klock is a wake-up alarm with missions (shake, QR, photo, squats, brain puzzles) that make sure you are really awake.",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "alarmklock",
    "ios": {
      "bundleIdentifier": "com.samay.alarmklock",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Alarm Klock uses the camera for photo and QR wake-up missions.",
        "NSMotionUsageDescription": "Alarm Klock uses motion sensors for shake, tilt and squat missions.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1"
            ]
          }
        ]
      },
      "icon": "./assets/icon.png",
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.samay.alarmklock",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-alarm-scheduler",
        {
          "alarmKitUsageDescription": "Alarm Klock uses system alarms so your wake-up alarm rings on the lock screen, even when the app is closed."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/classic.wav",
            "./assets/sounds/digital.wav",
            "./assets/sounds/siren.wav",
            "./assets/sounds/rise.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/classic_gentle.wav",
            "./assets/sounds/digital_gentle.wav",
            "./assets/sounds/siren_gentle.wav",
            "./assets/sounds/rise_gentle.wav",
            "./assets/sounds/chime_gentle.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Alarm Klock uses the camera for photo and QR wake-up missions.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {}
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "e21bc4e3-e21d-4ca8-951e-66a795378119"
      },
      "privacyPolicyUrl": "https://machine.esamay.live/alarm-klock/privacy",
      "supportUrl": "https://machine.esamay.live/alarm-klock/support"
    },
    "owner": "krosz",
    "updates": {
      "url": "https://u.expo.dev/e21bc4e3-e21d-4ca8-951e-66a795378119"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
